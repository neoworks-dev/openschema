type Difficulty string

const (
	DifficultyEasy Difficulty = "easy"
	DifficultyHard Difficulty = "hard"
)

// A shelf of recipes.
type Pantry struct {
	Name string `json:"name"`
}

// A recipe with one field of every kind the Go target maps.
type Recipe struct {
	Pantry     string        `json:"pantry"`
	Title      string        `json:"title"`
	Notes      *string       `json:"notes,omitempty"`
	Servings   int32         `json:"servings"`
	Calories   *float64      `json:"calories,omitempty"`
	Views      int64         `json:"views,string"`
	TotalViews *uint64       `json:"totalViews,omitempty,string"`
	CookTime   time.Duration `json:"cookTime,string"`
	// When it was last cooked.
	CookedAt    time.Time                    `json:"cookedAt"`
	LastCooked  *time.Time                   `json:"lastCooked,omitempty"`
	Day         string                       `json:"day"`
	StartsAt    *string                      `json:"startsAt,omitempty"`
	Token       string                       `json:"token"`
	PhotoData   collections.Bytes            `json:"photoData"`
	Thumbnail   *collections.Bytes           `json:"thumbnail,omitempty"`
	Extra       json.RawMessage              `json:"extra"`
	Annotations json.RawMessage              `json:"annotations,omitempty"`
	Version     string                       `json:"version"`
	Price       string                       `json:"price"`
	Favourite   bool                         `json:"favourite"`
	Level       uint8                        `json:"level"`
	Difficulty  Difficulty                   `json:"difficulty"`
	Mood        *Difficulty                  `json:"mood,omitempty"`
	Tags        []string                     `json:"tags,omitempty"`
	Allergens   []string                     `json:"allergens"`
	Counts      []collections.Int64          `json:"counts,omitempty"`
	Digits      []collections.Uint8          `json:"digits,omitempty"`
	Stamps      []time.Time                  `json:"stamps"`
	Blobs       []collections.Bytes          `json:"blobs,omitempty"`
	Related     []string                     `json:"related,omitempty"`
	Nutrition   map[string]float64           `json:"nutrition,omitempty"`
	Weights     map[string]collections.Int64 `json:"weights"`
	ByYear      map[int32]string             `json:"byYear,omitempty"`
	Flags       map[string]string            `json:"flags,omitempty"`
	Author      *Author                      `json:"author,omitempty"`
	Facts       Nutrition                    `json:"facts"`
	Steps       []Step                       `json:"steps,omitempty"`
	Sections    []Section                    `json:"sections"`
	Cover       *collections.File            `json:"cover,omitempty"`
	Gallery     []collections.File           `json:"gallery,omitempty"`
	Reminder    *RecipeReminder              `json:"reminder,omitempty"`
	Source      RecipeSource                 `json:"source"`
}

