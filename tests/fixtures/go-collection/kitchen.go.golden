	case value.Moment != nil:
		return json.Marshal(map[string]any{"moment": value.Moment})
	case value.Count != nil:
		return json.Marshal(map[string]any{"count": value.Count})
	}
	return nil, fmt.Errorf("RecipeReminderWhen: no variant is set")
}

func (value *RecipeReminderWhen) UnmarshalJSON(data []byte) error {
	var variants map[string]json.RawMessage
	if err := json.Unmarshal(data, &variants); err != nil {
		return err
	}
	if len(variants) != 1 {
		return fmt.Errorf("RecipeReminderWhen: expected one variant, got %d", len(variants))
	}
	*value = RecipeReminderWhen{}
	for name, raw := range variants {
		switch name {
		case "moment":
			value.Moment = new(time.Time)
			return json.Unmarshal(raw, value.Moment)
		case "count":
			value.Count = new(collections.Int64)
			return json.Unmarshal(raw, value.Count)
		}
	}
	return fmt.Errorf("RecipeReminderWhen: unknown variant")
}

// RecipeSource holds exactly one of its variants.
type RecipeSource struct {
	Url      *string
	Cookbook *collections.Int64
}

func (value RecipeSource) MarshalJSON() ([]byte, error) {
	switch {
	case value.Url != nil:
		return json.Marshal(map[string]any{"url": value.Url})
	case value.Cookbook != nil:
		return json.Marshal(map[string]any{"cookbook": value.Cookbook})
	}
	return nil, fmt.Errorf("RecipeSource: no variant is set")
}

func (value *RecipeSource) UnmarshalJSON(data []byte) error {
	var variants map[string]json.RawMessage
	if err := json.Unmarshal(data, &variants); err != nil {
		return err
	}
	if len(variants) != 1 {
		return fmt.Errorf("RecipeSource: expected one variant, got %d", len(variants))
	}
	*value = RecipeSource{}
	for name, raw := range variants {
		switch name {
		case "url":
			value.Url = new(string)
			return json.Unmarshal(raw, value.Url)
		case "cookbook":
			value.Cookbook = new(collections.Int64)
			return json.Unmarshal(raw, value.Cookbook)
		}
	}
	return fmt.Errorf("RecipeSource: unknown variant")
}

// Who wrote the recipe.
type Author struct {
	Name    string  `json:"name"`
	Website *string `json:"website,omitempty"`
}

type Nutrition struct {
	Energy    float64    `json:"energy"`
	Allergens []Allergen `json:"allergens,omitempty"`
}

type Allergen struct {
	Name string `json:"name"`
}

type Step struct {
	Text  string            `json:"text"`
	Photo *collections.File `json:"photo,omitempty"`
}

type Timer struct {
	Length time.Duration `json:"length,string"`
}

// A section of a cookbook that can hold further sections.
type Section struct {
	Title       string    `json:"title"`
	Child       *Section  `json:"child,omitempty"`
	Subsections []Section `json:"subsections,omitempty"`
}

// PantryFieldHandles builds conditions, orders and changes for the fields of Pantry.
type PantryFieldHandles struct {
	Name collections.StringField
}

func newPantryFieldHandles(path ...string) PantryFieldHandles {
	return PantryFieldHandles{
		Name: collections.NewStringField(collections.Child(path, "name")...),
	}
}

// RecipeFieldHandles builds conditions, orders and changes for the fields of Recipe.
type RecipeFieldHandles struct {
	Pantry      collections.RefField
	Title       collections.StringField
	Notes       collections.StringField
	Servings    collections.NumberField[int32]
	Calories    collections.NumberField[float64]
	Views       collections.NumberField[int64]
	TotalViews  collections.NumberField[uint64]
	CookTime    collections.NumberField[time.Duration]
	CookedAt    collections.TimeField
	LastCooked  collections.TimeField
	Day         collections.StringField
	StartsAt    collections.StringField
	Token       collections.StringField
	PhotoData   collections.BytesField
	Thumbnail   collections.BytesField
	Extra       collections.ValueField[json.RawMessage]
	Annotations collections.ValueField[json.RawMessage]
	Version     collections.ValueField[string]
	Price       collections.StringField
	Favourite   collections.BoolField
	Level       collections.NumberField[uint8]
	Difficulty  collections.EnumField[Difficulty]
	Mood        collections.EnumField[Difficulty]
	Tags        collections.ListField[[]string, collections.StringField]
	Allergens   collections.ListField[[]string, collections.StringField]
	Counts      collections.ListField[[]collections.Int64, collections.NumberField[int64]]
	Digits      collections.ListField[[]collections.Uint8, collections.NumberField[uint8]]
	Stamps      collections.ListField[[]time.Time, collections.TimeField]
	Blobs       collections.ValueField[[]collections.Bytes]
	Related     collections.ListField[[]string, collections.RefField]
	Nutrition   collections.ListField[map[string]float64, collections.NumberField[float64]]
	Weights     collections.ListField[map[string]collections.Int64, collections.NumberField[int64]]
	ByYear      collections.ListField[map[int32]string, collections.StringField]
	Flags       collections.ListField[map[string]string, collections.StringField]
	Author      AuthorFieldHandles
	Facts       NutritionFieldHandles
	Steps       collections.ListField[[]Step, StepFieldHandles]
	Sections    collections.ListField[[]Section, SectionFieldHandles]
	Cover       collections.FileField
	Gallery     collections.ListField[[]collections.File, collections.FileField]
	Reminder    collections.ValueField[RecipeReminder]
	Source      collections.ValueField[RecipeSource]
}

func newRecipeFieldHandles(path ...string) RecipeFieldHandles {
	return RecipeFieldHandles{
		Pantry:      collections.NewRefField(collections.Child(path, "pantry")...),
		Title:       collections.NewStringField(collections.Child(path, "title")...),
		Notes:       collections.NewStringField(collections.Child(path, "notes")...),
		Servings:    collections.NewNumberField[int32](collections.Child(path, "servings")...),
		Calories:    collections.NewNumberField[float64](collections.Child(path, "calories")...),
		Views:       collections.NewNumberField[int64](collections.Child(path, "views")...),
		TotalViews:  collections.NewNumberField[uint64](collections.Child(path, "totalViews")...),
		CookTime:    collections.NewNumberField[time.Duration](collections.Child(path, "cookTime")...),
		CookedAt:    collections.NewTimeField(collections.Child(path, "cookedAt")...),
		LastCooked:  collections.NewTimeField(collections.Child(path, "lastCooked")...),
		Day:         collections.NewStringField(collections.Child(path, "day")...),
		StartsAt:    collections.NewStringField(collections.Child(path, "startsAt")...),
		Token:       collections.NewStringField(collections.Child(path, "token")...),
		PhotoData:   collections.NewBytesField(collections.Child(path, "photoData")...),
		Thumbnail:   collections.NewBytesField(collections.Child(path, "thumbnail")...),
		Extra:       collections.NewValueField[json.RawMessage](collections.Child(path, "extra")...),
		Annotations: collections.NewValueField[json.RawMessage](collections.Child(path, "annotations")...),
		Version:     collections.NewValueField[string](collections.Child(path, "version")...),
		Price:       collections.NewStringField(collections.Child(path, "price")...),
		Favourite:   collections.NewBoolField(collections.Child(path, "favourite")...),
		Level:       collections.NewNumberField[uint8](collections.Child(path, "level")...),
		Difficulty:  collections.NewEnumField[Difficulty](collections.Child(path, "difficulty")...),
		Mood:        collections.NewEnumField[Difficulty](collections.Child(path, "mood")...),
		Tags:        collections.NewListField[[]string](collections.NewStringField, collections.Child(path, "tags")...),
		Allergens:   collections.NewListField[[]string](collections.NewStringField, collections.Child(path, "allergens")...),
		Counts:      collections.NewListField[[]collections.Int64](collections.NewNumberField[int64], collections.Child(path, "counts")...),
		Digits:      collections.NewListField[[]collections.Uint8](collections.NewNumberField[uint8], collections.Child(path, "digits")...),
		Stamps:      collections.NewListField[[]time.Time](collections.NewTimeField, collections.Child(path, "stamps")...),
		Blobs:       collections.NewValueField[[]collections.Bytes](collections.Child(path, "blobs")...),
		Related:     collections.NewListField[[]string](collections.NewRefField, collections.Child(path, "related")...),
		Nutrition:   collections.NewListField[map[string]float64](collections.NewNumberField[float64], collections.Child(path, "nutrition")...),
		Weights:     collections.NewListField[map[string]collections.Int64](collections.NewNumberField[int64], collections.Child(path, "weights")...),
		ByYear:      collections.NewListField[map[int32]string](collections.NewStringField, collections.Child(path, "byYear")...),
		Flags:       collections.NewListField[map[string]string](collections.NewStringField, collections.Child(path, "flags")...),
		Author:      newAuthorFieldHandles(collections.Child(path, "author")...),
		Facts:       newNutritionFieldHandles(collections.Child(path, "facts")...),
		Steps:       collections.NewListField[[]Step](newStepFieldHandles, collections.Child(path, "steps")...),
		Sections:    collections.NewListField[[]Section](newSectionFieldHandles, collections.Child(path, "sections")...),
		Cover:       collections.NewFileField(collections.Child(path, "cover")...),
		Gallery:     collections.NewListField[[]collections.File](collections.NewFileField, collections.Child(path, "gallery")...),
		Reminder:    collections.NewValueField[RecipeReminder](collections.Child(path, "reminder")...),
		Source:      collections.NewValueField[RecipeSource](collections.Child(path, "source")...),
	}
}

// AuthorFieldHandles builds conditions, orders and changes for the fields of Author.
type AuthorFieldHandles struct {
	collections.MessageField[Author]
	Name    collections.StringField
	Website collections.StringField
}

func newAuthorFieldHandles(path ...string) AuthorFieldHandles {
	return AuthorFieldHandles{
		MessageField: collections.NewMessageField[Author](path...),
		Name:         collections.NewStringField(collections.Child(path, "name")...),
		Website:      collections.NewStringField(collections.Child(path, "website")...),
	}
}

// NutritionFieldHandles builds conditions, orders and changes for the fields of Nutrition.
type NutritionFieldHandles struct {
	collections.MessageField[Nutrition]
	Energy    collections.NumberField[float64]
	Allergens collections.ListField[[]Allergen, AllergenFieldHandles]
}

func newNutritionFieldHandles(path ...string) NutritionFieldHandles {
	return NutritionFieldHandles{
		MessageField: collections.NewMessageField[Nutrition](path...),
		Energy:       collections.NewNumberField[float64](collections.Child(path, "energy")...),
		Allergens:    collections.NewListField[[]Allergen](newAllergenFieldHandles, collections.Child(path, "allergens")...),
	}
}

// StepFieldHandles builds conditions, orders and changes for the fields of Step.
type StepFieldHandles struct {
	collections.MessageField[Step]
	Text  collections.StringField
	Photo collections.FileField
}

func newStepFieldHandles(path ...string) StepFieldHandles {
	return StepFieldHandles{
		MessageField: collections.NewMessageField[Step](path...),
		Text:         collections.NewStringField(collections.Child(path, "text")...),
		Photo:        collections.NewFileField(collections.Child(path, "photo")...),
	}
}

// SectionFieldHandles builds conditions, orders and changes for the fields of Section.
type SectionFieldHandles struct {
	collections.MessageField[Section]
	path        []string
	Title       collections.StringField
	Subsections collections.ListField[[]Section, SectionFieldHandles]
}

func newSectionFieldHandles(path ...string) SectionFieldHandles {
	return SectionFieldHandles{
		MessageField: collections.NewMessageField[Section](path...),
		path:         path,
		Title:        collections.NewStringField(collections.Child(path, "title")...),
		Subsections:  collections.NewListField[[]Section](newSectionFieldHandles, collections.Child(path, "subsections")...),
	}
}

func (handles SectionFieldHandles) Child() SectionFieldHandles {
	return newSectionFieldHandles(collections.Child(handles.path, "child")...)
}

// AllergenFieldHandles builds conditions, orders and changes for the fields of Allergen.
type AllergenFieldHandles struct {
	collections.MessageField[Allergen]
	Name collections.StringField
}

func newAllergenFieldHandles(path ...string) AllergenFieldHandles {
	return AllergenFieldHandles{
		MessageField: collections.NewMessageField[Allergen](path...),
		Name:         collections.NewStringField(collections.Child(path, "name")...),
	}
}

// PantryFields holds the handles of the fields of Pantry.
var PantryFields = newPantryFieldHandles()

// RecipeFields holds the handles of the fields of Recipe.
var RecipeFields = newRecipeFieldHandles()

// Tables holds one table per model of the collection.
type Tables struct {
	Pantries *collections.Table[Pantry]
	Recipes  *collections.Table[Recipe]
}

// Open opens the collection in the vault and returns its tables.
func Open(v *vault.Vault, options ...collections.Option) (*Tables, error) {
	collection, err := collections.Open(v, Schema, options...)
	if err != nil {
		return nil, err
	}
	return &Tables{
		Pantries: collections.NewTable[Pantry](collection, collections.TableDefinition{Model: "Pantry"}),
		Recipes:  collections.NewTable[Recipe](collection, collections.TableDefinition{Model: "Recipe", References: map[string]string{"pantry": "Pantry"}}),
	}, nil
}
